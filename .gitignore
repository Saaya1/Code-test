import json
import os
import re
import time
import winsound
from datetime import datetime

from plyer import notification
from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager


ORIGIN = "MSY"
DESTINATION = "KTM"

DEPARTURE_DATE = "2026-11-18"
RETURN_DATE = "2026-11-30"

TARGET_PRICE = 1700
MIN_VALID_FARE = 900
MAX_VALID_FARE = 4000

PRICE_FILE = "qatar_msy_ktm_roundtrip_price.json"
ROUTE_KEY = "QATAR_MSY_KTM_ROUNDTRIP"

CHECK_EVERY_MINUTES = 60   # change to 30, 120, etc.


def send_notification(title, message):
    try:
        winsound.Beep(2000, 1200)
        notification.notify(
            title=title,
            message=message,
            timeout=15
        )
        print(f"\nNOTIFICATION: {title}")
        print(message)
    except Exception as e:
        print("Notification error:", e)


def load_prices():
    if os.path.exists(PRICE_FILE):
        with open(PRICE_FILE, "r") as f:
            return json.load(f)
    return {}


def save_prices(prices):
    with open(PRICE_FILE, "w") as f:
        json.dump(prices, f, indent=2)


def get_qatar_roundtrip_price(driver):

    url = (
        f"https://www.google.com/travel/flights?"
        f"hl=en#flt={ORIGIN}.{DESTINATION}.{DEPARTURE_DATE}*"
        f"{DESTINATION}.{ORIGIN}.{RETURN_DATE};"
        f"c:USD;e:1;sd:1;t:f"
    )

    print("\n==============================")
    print("Checking Qatar Airways fare")
    print(f"{ORIGIN} ↔ {DESTINATION}")
    print(f"Depart: {DEPARTURE_DATE}")
    print(f"Return: {RETURN_DATE}")
    print(datetime.now().strftime("%Y-%m-%d %I:%M:%S %p"))
    print(url)

    driver.get(url)
    time.sleep(35)

    page_text = driver.find_element("tag name", "body").text

    with open("google_flights_text.txt", "w", encoding="utf-8") as f:
        f.write(page_text)

    if not page_text.strip():
        print("Page text is empty.")
        return None

    if "qatar" not in page_text.lower():
        print("Qatar Airways not found on visible page.")
        print("Open google_flights_text.txt to inspect what Google showed.")
        return None

    lines = page_text.splitlines()
    qatar_prices = []

    for i, line in enumerate(lines):
        if "qatar" in line.lower():
            nearby_text = "\n".join(lines[max(0, i - 25): i + 35])
            found_prices = re.findall(r"\$([0-9,]+)", nearby_text)

            for p in found_prices:
                try:
                    value = int(p.replace(",", ""))
                    if MIN_VALID_FARE <= value <= MAX_VALID_FARE:
                        qatar_prices.append(value)
                except:
                    pass

    qatar_prices = sorted(set(qatar_prices))

    print("Qatar-related fares detected:")
    print(qatar_prices)

    if not qatar_prices:
        print("Qatar was found, but no nearby valid fare was detected.")
        print("Open google_flights_text.txt to inspect the page.")
        return None

    return min(qatar_prices)


def run_once():

    old_prices = load_prices()

    options = webdriver.ChromeOptions()
    options.add_argument("--disable-blink-features=AutomationControlled")
    options.add_argument("--window-size=1920,1080")
    options.add_argument("--start-maximized")

    driver = webdriver.Chrome(
        service=Service(ChromeDriverManager().install()),
        options=options
    )

    try:
        price = get_qatar_roundtrip_price(driver)

        if price is None:
            send_notification(
                "Qatar MSY ↔ KTM Tracker",
                "Could not detect Qatar roundtrip fare."
            )
            return

        print(f"Lowest Qatar roundtrip fare detected: ${price}")

        previous = old_prices.get(ROUTE_KEY)

        if price <= TARGET_PRICE:
            send_notification(
                "🔥 Qatar Fare Alert",
                f"MSY ↔ KTM Qatar roundtrip is ${price}\nTarget: ${TARGET_PRICE}"
            )
        else:
            print(f"Qatar fare is above target: ${price}")

        if previous is not None:
            change = price - previous
            if abs(change) >= 50:
                if change < 0:
                    send_notification(
                        "✈ Qatar Fare Dropped",
                        f"MSY ↔ KTM\n${previous} → ${price}"
                    )
                else:
                    send_notification(
                        "⚠ Qatar Fare Increased",
                        f"MSY ↔ KTM\n${previous} → ${price}"
                    )

        old_prices[ROUTE_KEY] = price
        save_prices(old_prices)

    finally:
        driver.quit()


def start_tracker():
    while True:
        run_once()
        print(f"\nNext check in {CHECK_EVERY_MINUTES} minutes.")
        time.sleep(CHECK_EVERY_MINUTES * 60)


# Run one time only:
run_once()

# To keep tracking every hour, run this instead:
# start_tracker()

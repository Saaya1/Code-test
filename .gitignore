import json
import os
import re
import time

from plyer import notification
from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager

# ==========================
# SETTINGS
# ==========================

ORIGIN = "MSY"

DESTINATIONS = {
    "Tokyo Narita": "NRT",
    "Tokyo Haneda": "HND",
    "Osaka": "KIX",
    "Sapporo": "CTS",
    "Fukuoka": "FUK"
}

DEPARTURE_DATE = "2026-11-10"

PRICE_FILE = "flight_prices.json"

ALERT_THRESHOLD = 50  # dollars

# ==========================
# NOTIFICATION
# ==========================

def send_notification(title, message):
    try:
        notification.notify(
            title=title,
            message=message,
            timeout=15
        )
    except Exception as e:
        print("Notification error:", e)

# ==========================
# PRICE STORAGE
# ==========================

def load_prices():
    if os.path.exists(PRICE_FILE):
        with open(PRICE_FILE, "r") as f:
            return json.load(f)
    return {}

def save_prices(prices):
    with open(PRICE_FILE, "w") as f:
        json.dump(prices, f, indent=2)

# ==========================
# GOOGLE FLIGHTS SCRAPER
# ==========================

def get_price(driver, destination_code):

    url = (
        f"https://www.google.com/travel/flights?"
        f"hl=en#flt={ORIGIN}.{destination_code}.{DEPARTURE_DATE};c:USD;e:1;sd:1;t:f"
    )

    print(f"Checking {destination_code}")

    driver.get(url)

    time.sleep(8)

    html = driver.page_source

    matches = re.findall(r"\$([0-9,]+)", html)

    prices = []

    for p in matches:
        try:
            value = int(p.replace(",", ""))

            if 200 <= value <= 5000:
                prices.append(value)

        except:
            pass

    if not prices:
        return None

    return min(prices)

# ==========================
# MAIN
# ==========================

def main():

    old_prices = load_prices()
    new_prices = {}

    options = webdriver.ChromeOptions()

    # Comment this out if you want to watch browser activity
    options.add_argument("--headless=new")

    options.add_argument(
        "--disable-blink-features=AutomationControlled"
    )

    driver = webdriver.Chrome(
        service=Service(
            ChromeDriverManager().install()
        ),
        options=options
    )

    try:

        for city, airport in DESTINATIONS.items():

            price = get_price(driver, airport)

            if price is None:
                print(f"Could not get fare for {city}")
                continue

            new_prices[airport] = price

            print(f"{city}: ${price}")

            previous = old_prices.get(airport)

            if previous is None:

                send_notification(
                    "Flight Tracker",
                    f"Baseline saved: {city} ${price}"
                )

            else:

                change = price - previous

                if abs(change) >= ALERT_THRESHOLD:

                    if change < 0:

                        send_notification(
                            "✈ Flight Price Dropped",
                            (
                                f"{city}\n"
                                f"${previous} → ${price}\n"
                                f"Saved ${abs(change)}"
                            )
                        )

                    else:

                        send_notification(
                            "⚠ Flight Price Increased",
                            (
                                f"{city}\n"
                                f"${previous} → ${price}\n"
                                f"+${change}"
                            )
                        )

    finally:
        driver.quit()

    save_prices(new_prices)

    print("\nDone.")

# ==========================
# RUN
# ==========================

main()
